<?xml version="1.0" encoding="UTF-8" ?>
<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="bg-theme-primary">
    <ActionBar title="Nastavení" class="bg-blue-600 text-white">
        <NavigationButton text="Zpět" android.systemIcon="ic_menu_back" />
    </ActionBar>

    <ScrollView>
        <StackLayout class="p-4 space-y-4 animate-fade-in">
            <!-- Aktivační fráze -->
            <Label text="Aktivační fráze" class="text-lg font-bold text-theme-primary" />
            <GridLayout columns="*, auto" class="mb-2">
                <TextField col="0" text="{{ currentPhrase }}" accessibilityLabel="Pole pro novou aktivační frázi" hint="Zadejte novou frázi"
                          class="p-2 bg-theme-secondary rounded border-theme border-width-1 text-theme-primary" />
                <Button col="1" text="➕ Přidat" tap="{{ addPhrase }}" accessibilityLabel="Přidat aktivační frázi"
                        class="ml-2 bg-blue-500 text-white font-bold rounded-lg transition-normal btn-press" />
            </GridLayout>

            <ListView items="{{ wakePhrases }}" class="bg-theme-secondary rounded-lg shadow-theme">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" class="p-2 border-b border-theme">
                        <Label col="0" text="{{ $value }}" class="text-theme-primary" />
                        <Button col="1" text="🗑️ Odstranit" tap="{{ $parent.removePhrase }}" accessibilityLabel="Odstranit aktivační frázi"
                                class="bg-red-500 text-white text-sm rounded transition-normal btn-press" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- Zvuková zpětná vazba -->
            <Label text="Zvuková zpětná vazba" class="text-lg font-bold text-theme-primary mt-4" />
            <Switch checked="{{ feedbackEnabled }}" accessibilityLabel="Zvuková zpětná vazba" class="ml-2" />

            <!-- Citlivost rozpoznávání -->
            <Label text="Citlivost rozpoznávání" class="text-lg font-bold text-theme-primary mt-4" />
            <Slider value="{{ sensitivity }}" accessibilityLabel="Citlivost rozpoznávání" minValue="0" maxValue="1" class="ml-2" />
            <Label text="{{ sensitivity | number:'1.1' }}" class="text-center text-theme-secondary" />

            <!-- Jazyk rozpoznávání řeči (P3) -->
            <StackLayout>
                <Label text="Jazyk rozpoznávání řeči" class="text-sm font-medium text-theme-secondary" />
                <DropDown selectedIndex="0" class="p-2 bg-white rounded border-theme border-width-1 text-gray-800" accessibilityLabel="Jazyk rozpoznávání řeči">
                    <DropDown.items>
                        <DropDownItem v-for="lang in availableRecognitionLanguages"
                                     [value]="lang.value"
                                     [text]="lang.label" />
                    </DropDown.items>
                    <DropDown.selectedValue twoWay="true">
                        <Binding path="recognitionLanguage" />
                    </DropDown.selectedValue>
                </DropDown>
            </StackLayout>

            <!-- Akce -->
            <Label text="Akce" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />

            <!-- Formulář pro přidání akce -->
            <StackLayout class="space-y-2 bg-theme-secondary p-3 rounded-lg shadow-theme">
                <Label text="Přidat novou akci" class="font-semibold text-theme-primary" />
                <TextField text="{{ newActionName }}" hint="Název (např. Světlo v obýváku)" class="p-2 bg-white rounded text-gray-800" />
                <TextField text="{{ newActionPhrase }}" hint="Spouštěcí fráze (např. rozsviť světlo)" class="p-2 bg-white rounded text-gray-800" />

                <!-- Přepínač typu akce -->
                <SegmentedBar selectedIndex="{{ newActionType === 'webhook' ? 0 : (newActionType === 'tasker' ? 1 : 2) }}"
                              tap="{{ (args) => { newActionType = args.object.selectedIndex === 0 ? 'webhook' : (args.object.selectedIndex === 1 ? 'tasker' : 'ifttt') } }}"
                              class="mt-2">
                    <SegmentedBarItem title="Webhook" />
                    <SegmentedBarItem title="Tasker" />
                    <SegmentedBarItem title="IFTTT" />
                </SegmentedBar>

                <!-- Pole pro URL (viditelné jen pro webhook) -->
                <TextField text="{{ newActionUrl }}" hint="URL adresa webhooku" autocapitalizationType="none"
                           visibility="{{ newActionType === 'webhook' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />

                <!-- Pole pro název úlohy (viditelné jen pro Tasker) -->
                <TextField text="{{ newActionTaskName }}" hint="Název úlohy v Taskeru" autocapitalizationType="none"
                           visibility="{{ newActionType === 'tasker' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />

                <!-- Pole pro IFTTT (viditelná jen pro IFTTT) -->
                <TextField text="{{ newActionIftttEvent }}" hint="Název IFTTT události (např. light_on)" autocapitalizationType="none"
                           visibility="{{ newActionType === 'ifttt' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />
                <TextField text="{{ newActionIftttKey }}" hint="Klíč Maker Webhooks (Settings > Services)" autocapitalizationType="none"
                           visibility="{{ newActionType === 'ifttt' ? 'visible' : 'collapsed' }}"
                           class="p-2 bg-white rounded mt-1 text-gray-800" />

                <Button text="➕ Přidat akci" tap="{{ addAction }}" accessibilityLabel="Přidat novou akci" class="mt-2 bg-blue-500 text-white font-bold rounded-lg transition-normal btn-press" />
            </StackLayout>

            <!-- Seznam akcí -->
            <ListView items="{{ actions }}" class="bg-theme-secondary rounded-lg shadow-theme mt-4">
                <ListView.itemTemplate>
                    <GridLayout columns="*, auto" rows="auto, auto, auto" class="p-3 border-b border-theme">
                        <StackLayout row="0" col="0" orientation="horizontal">
                            <Label text="{{ name }}" class="font-bold text-lg text-theme-primary" />
                            <Label text="{{ ' (' + type + ')' }}" class="text-sm text-theme-secondary align-bottom ml-1" />
                        </StackLayout>

                        <Label row="1" col="0" text="{{ phrase }}" class="text-sm text-theme-secondary mt-1" />

                        <Label row="2" col="0" text="{{ type === 'webhook' ? url : (type === 'ifttt' ? iftttEvent : taskName) }}"
                               class="text-xs text-blue-400 mt-1" textWrap="true" />

                        <Button row="0" rowspan="3" col="1" text="🗑️ Odstranit" tap="{{ $parent.removeAction }}" accessibilityLabel="Odstranit akci"
                                class="bg-red-500 text-white text-sm rounded m-auto transition-normal btn-press" />
                    </GridLayout>
                </ListView.itemTemplate>
            </ListView>

            <!-- Historie příkazů -->
            <Button text="🕘 Historie příkazů" tap="{{ showHistory }}" accessibilityLabel="Otevřít historii příkazů"
                    class="bg-purple-500 text-white font-bold p-3 rounded-lg mt-6 transition-normal btn-press" />

            <!-- Statistiky -->
            <Button text="📊 Statistiky použití" tap="{{ showStatistics }}" accessibilityLabel="Otevřít statistiky použití"
                    class="bg-orange-500 text-white font-bold p-3 rounded-lg transition-normal btn-press" />

            <!-- TTS Nastavení -->
            <Label text="Hlasová zpětná vazba (TTS)" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />

            <StackLayout class="bg-theme-secondary p-4 rounded-lg shadow-theme space-y-3">
                <!-- Povolit TTS -->
                <StackLayout orientation="horizontal" class="space-x-2">
                    <Switch checked="{{ ttsEnabled }}" accessibilityLabel="Povolit hlasovou zpětnou vazbu" class="mt-1" />
                    <Label text="Povolit hlasovou zpětnou vazbu" class="text-theme-primary" />
                </StackLayout>

                <!-- Jazyk -->
                <StackLayout>
                    <Label text="Jazyk" class="text-sm font-medium text-theme-secondary" />
                    <DropDown selectedIndex="0" class="p-2 bg-white rounded border-theme border-width-1 text-gray-800">
                        <DropDown.items>
                            <DropDownItem v-for="lang in availableLanguages"
                                         [value]="lang"
                                         [text]="lang" />
                        </DropDown.items>
                        <DropDown.selectedValue twoWay="true">
                            <Binding path="ttsLanguage" />
                        </DropDown.selectedValue>
                    </DropDown>
                </StackLayout>

                <!-- Výška hlasu -->
                <StackLayout>
                    <Label text="Výška hlasu: {{ ttsPitch | number:'1.1' }}" class="text-sm font-medium text-theme-secondary" />
                    <Slider value="{{ ttsPitch }}" accessibilityLabel="Výška hlasu" minValue="0.5" maxValue="2.0" step="0.1" class="ml-2" />
                </StackLayout>

                <!-- Rychlost řeči -->
                <StackLayout>
                    <Label text="Rychlost řeči: {{ ttsRate | number:'1.1' }}" class="text-sm font-medium text-theme-secondary" />
                    <Slider value="{{ ttsRate }}" accessibilityLabel="Rychlost řeči" minValue="0.5" maxValue="2.0" step="0.1" class="ml-2" />
                </StackLayout>

                <!-- Test TTS -->
                <Button text="🔊 Testovat TTS" tap="{{ testTTS }}" accessibilityLabel="Otestovat hlasovou zpětnou vazbu"
                        class="bg-green-500 text-white font-bold p-2 rounded-lg transition-normal btn-press" />
            </StackLayout>

            <!-- Tmavý režim -->
            <Label text="Vzhled" class="text-lg font-bold text-theme-primary mt-6 border-t-2 border-theme pt-4" />
            <StackLayout class="bg-theme-secondary p-4 rounded-lg shadow-theme space-y-3">
                <Label text="Režim zobrazení" class="text-sm font-medium text-theme-secondary" />
                <DropDown selectedIndex="0" class="p-2 bg-white rounded border-theme border-width-1 text-gray-800">
                    <DropDown.items>
                        <DropDownItem v-for="mode in themeModes"
                                     [value]="mode.value"
                                     [text]="mode.label" />
                    </DropDown.items>
                    <DropDown.selectedValue twoWay="true">
                        <Binding path="currentThemeMode" />
                    </DropDown.selectedValue>
                </DropDown>
                <Label text="Aktuální režim: {{ currentThemeMode }}" class="text-xs text-theme-secondary" />

                <!-- Vysoký kontrast (P3) -->
                <StackLayout orientation="horizontal" class="space-x-2 mt-2">
                    <Switch checked="{{ highContrast }}" class="mt-1" accessibilityLabel="Vysoký kontrast" />
                    <Label text="Vysoký kontrast" class="text-theme-primary" />
                </StackLayout>

                <!-- Vlastní barvy (P3: Implementovat custom téma) -->
                <Label text="Vlastní barvy" class="text-sm font-medium text-theme-secondary mt-4" />
                <Label text="Primární barva" class="text-xs text-theme-secondary" />
                <Label text="Aktuální: {{ primaryColor }}" class="text-xs text-theme-secondary" />
                <ListView items="{{ colorPalette }}" class="mt-1" height="200">
                    <ListView.itemTemplate>
                        <GridLayout columns="auto, *" class="p-1">
                            <Button col="0" width="36" height="36" borderRadius="100"
                                    backgroundColor="{{ hex }}" tap="{{ $parent.selectPrimaryColor }}"
                                    accessibilityLabel="Vybrat primární barvu {{ label }}" />
                            <Label col="1" text="{{ label }}" class="text-theme-primary ml-3"
                                   verticalAlignment="center" />
                        </GridLayout>
                    </ListView.itemTemplate>
                </ListView>

                <Label text="Akcentová barva" class="text-xs text-theme-secondary mt-3" />
                <Label text="Aktuální: {{ accentColor }}" class="text-xs text-theme-secondary" />
                <ListView items="{{ colorPalette }}" class="mt-1" height="200">
                    <ListView.itemTemplate>
                        <GridLayout columns="auto, *" class="p-1">
                            <Button col="0" width="36" height="36" borderRadius="100"
                                    backgroundColor="{{ hex }}" tap="{{ $parent.selectAccentColor }}"
                                    accessibilityLabel="Vybrat akcentovou barvu {{ label }}" />
                            <Label col="1" text="{{ label }}" class="text-theme-primary ml-3"
                                   verticalAlignment="center" />
                        </GridLayout>
                    </ListView.itemTemplate>
                </ListView>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</Page>
