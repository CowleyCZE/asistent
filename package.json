{
  "name": "cze-asistent",
  "version": "1.0.0",
  "description": "Hlasový asistent pro Android",
  "main": "app.ts",
  "scripts": {
    "android": "ns run android",
    "start": "ns preview",
    "ios": "ns run ios",
    "preview": "ns preview",
    "postinstall": "node ./setup-nativescript.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "wdio tests/e2e/wdio.conf.js",
    "e2e:driver": "appium driver install uiautomator2",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "docs": "typedoc"
  },
  "keywords": [
    "nativescript",
    "android",
    "voice",
    "assistant",
    "webhook",
    "tasker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nativescript/android": "~8.3.0",
    "@nativescript/core": "~8.3.0",
    "@nativescript/theme": "~3.0.1"
  },
  "devDependencies": {
    "@nativescript/preview-cli": "1.0.15",
    "@nativescript/tailwind": "~2.0.1",
    "@nativescript/types": "~8.3.0",
    "@nativescript/webpack": "^5.0.22",
    "@types/jest": "^29.5.12",
    "@wdio/appium-service": "^8.36.8",
    "@wdio/cli": "^8.36.8",
    "@wdio/local-runner": "^8.36.8",
    "@wdio/mocha-framework": "^8.36.8",
    "@wdio/spec-reporter": "^8.36.8",
    "appium": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "~3.3.2",
    "ts-jest": "^29.1.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.23.28",
    "typescript": "~4.7.4",
    "webpack": "5.88.2"
  },
  "nativescript": {
    "id": "org.nativescript.czechvoiceassistant",
    "tns-android": {
      "version": "8.3.0"
    }
  }
}
